# Groq API key  -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Models (both run on Groq; kept separate on purpose: guard != agent)
AGENT_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-safeguard-20b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Airtable security logging (optional - CSV logging always works)
AIRTABLE_PAT=your_airtable_pat
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_NAME=your_table_name

# Required ONLY for system_evaluation.py (DeepEval metrics use an OpenAI judge by default)
OPENAI_API_KEY=your_openai_api_key
